<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{{ apache_app_name | default('NOVA Studio') }}</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #141e30, #243b55);
            color: white;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .container {
            max-width: 650px;
            padding: 50px;
            background: rgba(255,255,255,0.08);
            border-radius: 20px;
        }

        h1 {
            color: #00e5ff;
            font-size: 42px;
        }

        p {
            color: #d5e3f0;
            font-size: 18px;
            line-height: 1.6;
        }

        .status {
            display: inline-block;
            padding: 12px 25px;
            background: #00c853;
            border-radius: 30px;
            font-weight: bold;
        }
    </style>
</head>

<body>
    <div class="container">

        <h1>{{ apache_app_name | default('NOVA Studio') }}</h1>

        <p>{{ apache_deployment_message }}</p>

        <p>Server: {{ inventory_hostname }}</p>

        <p>Operating System: {{ ansible_distribution }}</p>

        <p>Environment: {{ apache_environment | default('Development') }}</p>

        <div class="status">
            APACHE ONLINE
        </div>

    </div>
</body>
</html>
